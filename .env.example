# LinkedIn session. Password login currently hits LinkedIn's app-approval
# challenge, so paste cookies from a session you already signed in with.
#
# Both li_at and JSESSIONID must come from the same session.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
# Optional. Paste the full Cookie request header instead of (or in addition to) the two vars above.
# LINKEDIN_COOKIE=

# Optional fallback if you want password login instead of a cookie.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Optional. If set, every /v1 request must send X-API-Key.
API_KEY=

# Optional tuning
PORT=8080
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL_SECONDS=600
REQUEST_TIMEOUT_MS=20000
LINKEDIN_MIN_INTERVAL_MS=1000
PROFILE_COOLDOWN_MS=8000
LOG_LEVEL=info
