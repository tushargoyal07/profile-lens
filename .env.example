# LinkedIn session from a logged-in browser.
# Chrome: DevTools → Application → Cookies → https://www.linkedin.com
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Optional. If set, every /v1 request must send X-API-Key.
API_KEY=

# Optional tuning
PORT=8080
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL_SECONDS=600
REQUEST_TIMEOUT_MS=20000
LINKEDIN_MIN_INTERVAL_MS=250
LOG_LEVEL=info
