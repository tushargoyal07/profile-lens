# LinkedIn session. Password login currently hits LinkedIn's app-approval
# challenge, so paste a cookie from a browser you already signed in with.
#
# DevTools → Application → Cookies → https://www.linkedin.com → li_at
LINKEDIN_LI_AT=
# Optional. Paste the full Cookie request header instead of (or in addition to) li_at.
# LINKEDIN_COOKIE=
# LINKEDIN_JSESSIONID=

# Optional fallback if you want password login instead of a cookie.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Optional. If set, every /v1 request must send X-API-Key.
API_KEY=

# Optional tuning
PORT=8080
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL_SECONDS=600
REQUEST_TIMEOUT_MS=20000
LINKEDIN_MIN_INTERVAL_MS=250
LOG_LEVEL=info
